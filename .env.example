# Copie para .env e preencha com seus valores: cp .env.example .env
# Atenção: o .env é lido na inicialização; reinicie a aplicação após alterá-lo.

# === Obrigatória ===
# Chave da Claude API. Obtenha em https://console.anthropic.com/
# Necessária para gerar respostas (/query, make query, make eval).
# Indexação e testes NÃO precisam dela.
ANTHROPIC_API_KEY=your_key_here

# === Modelos (opcionais) ===
# Modelo da Claude para gerar as respostas.
# Padrão: claude-haiku-4-5 (classe econômica, ideal para RAG).
# CLAUDE_MODEL=claude-haiku-4-5

# Modelo de embeddings local (384 dimensões, gratuito, sem API).
# EMBEDDING_MODEL=all-MiniLM-L6-v2

# Device dos embeddings: cpu (padrão, seguro) ou cuda (só com GPU compatível;
# em WSL2 normalmente não é — mantenha cpu).
# EMBEDDING_DEVICE=cpu

# === Chunking e busca (opcionais) ===
# CHUNK_SIZE_WORDS=300
# CHUNK_OVERLAP_WORDS=50
# DEFAULT_TOP_K=3

# === Preços para estimativa de custo (opcionais) ===
# Devem corresponder ao CLAUDE_MODEL escolhido (padrão: Haiku 4.5).
# PRICE_INPUT_PER_1M=1.0
# PRICE_OUTPUT_PER_1M=5.0
